// ============================================================
// 国际教育语言培训 AI 销售顾问助手 — 数据库 Schema
// 覆盖规格书第十二章的 14 张核心表 + 会话表（Session，用于登录态）
// 说明：
//   - 用户数据按 userId 隔离，所有业务表均带 userId 归属字段
//   - KnowledgeChunk.embedding 使用 pgvector(vector(1024))，
//     需在数据库中启用扩展：CREATE EXTENSION IF NOT EXISTS vector;
//   - 金额以"分"(priceCents)存储，避免浮点误差
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- 枚举 ----------

enum UserRole {
  ADMIN // 管理员
  ADVISOR // 销售顾问
}

enum UserStatus {
  ACTIVE // 正常
  DISABLED // 停用
}

enum SenderRole {
  ADVISOR // 顾问本人
  CUSTOMER // 客户
  UNKNOWN // 未知身份
}

enum KnowledgeStatus {
  APPROVED // 已审核
  PENDING_APPROVAL // 待审核
  PENDING_VERIFY // 待核实
  EXPIRED // 已失效
  REJECTED // 已驳回
}

// ---------- 账号 ----------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(ADVISOR)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile              AdvisorProfile?
  sessions             Session[]
  customers            Customer[]
  conversations        Conversation[]
  screenshotAssets     ScreenshotAsset[]
  replyGenerations     ReplyGeneration[]
  replyFeedbacks       ReplyFeedback[]
  styleExamples        StyleExample[]
  styleProfileVersions StyleProfileVersion[]
  knowledgeDocuments   KnowledgeDocument[]
  courseProducts       CourseProduct[]
  auditLogs            AuditLog[]
  conversationAnalyses ConversationAnalysis[]
  customerFacts        CustomerFact[]
  savedReplies         SavedReply[]
  followUpTasks        FollowUpTask[]
  studyPlans           StudyPlan[]
  salesMaterials       SalesMaterial[]
  personalIdentity     PersonalIdentity?
  themePreference      UserThemePreference?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------- 顾问资料与个人风格 ----------

model AdvisorProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyStyle            Json? // 回复偏好（句长、语气、分段习惯等）
  styleProfileVersionId String?
  styleProfileVersion   StyleProfileVersion? @relation(fields: [styleProfileVersionId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model StyleExample {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerContext String? // 客户问题 / 上下文
  advisorReply    String // 真实顾问回复
  source          String? // screenshot / paste / ai_edit / confirmed
  sourceImageId   String?
  sourceImage     ScreenshotAsset? @relation(fields: [sourceImageId], references: [id], onDelete: SetNull)
  status          String           @default("ACTIVE") // ACTIVE / EXCLUDED
  tags            Json?
  createdAt       DateTime         @default(now())

  @@index([userId, status])
  @@index([userId, createdAt])
}

model StyleProfileVersion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     Int
  profile     Json // 风格画像内容（称呼、口头语、句式、长度、情绪表达等）
  sampleCount Int      @default(0)
  confidence  Float? // 风格稳定性置信度
  note        String?
  createdAt   DateTime @default(now())

  advisorProfiles  AdvisorProfile[]
  replyGenerations ReplyGeneration[]

  @@unique([userId, version])
  @@index([userId, createdAt])
}

// ---------- 客户与沟通记录 ----------

model Customer {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code                  String // 客户代号（昵称 / 编号）
  contactRole           String? // 学生 / 家长 / 未知
  targetCountry         String?
  targetSchool          String? // 目标院校
  targetMajor           String? // 目标专业
  applicationStage      String? // 申请阶段
  targetExam            String?
  targetScore           String?
  existingScore         String? // 已有考试成绩
  currentLevel          String? // 现有语言基础
  plannedExamDate       DateTime?
  plannedEnrollmentDate DateTime? // 计划入学时间
  trainingNeeds         String?
  budgetRange           String?
  concerns              String? // 当前顾虑
  confirmedNextStep     String? // 已确认的下一步安排
  salesStage            String? // 咨询阶段
  summary               String? // 咨询摘要（长对话摘要）
  lastContactAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  conversations    Conversation[]
  replyGenerations ReplyGeneration[]
  facts            CustomerFact[]
  savedReplies     SavedReply[]
  followUpTasks    FollowUpTask[]
  studyPlans       StudyPlan[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model Conversation {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title           String?
  summary         String?
  source          String? // 来源：wechat / manual / web
  recognitionMeta Json? // 识别元数据（模型、耗时、不确定项）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages         ChatMessage[]
  screenshots      ScreenshotAsset[]
  replyGenerations ReplyGeneration[]
  analyses         ConversationAnalysis[]
  facts            CustomerFact[]
  savedReplies     SavedReply[]
  followUpTasks    FollowUpTask[]
  studyPlans       StudyPlan[]

  @@index([userId, updatedAt])
  @@index([customerId])
}

model ChatMessage {
  id                String           @id @default(cuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole        SenderRole       @default(UNKNOWN)
  content           String?
  timestamp         DateTime?
  sequence          Int
  sourceImageId     String?
  sourceImage       ScreenshotAsset? @relation(fields: [sourceImageId], references: [id], onDelete: SetNull)
  confidence        Float? // AI 识别置信度
  note              String? // 识别备注（如"发言方不确定"）
  manuallyCorrected Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([conversationId, sequence])
  @@index([sourceImageId])
}

model ScreenshotAsset {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId      String?
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  originalName        String
  mimeType            String
  sizeBytes           Int
  storagePath         String // 相对受保护存储根目录的路径
  width               Int?
  height              Int?
  status              String        @default("UPLOADED") // UPLOADED / ANALYZED / FAILED
  contentHash         String? // 内容哈希，用于多图去重
  keepAfterProcessing Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  messages      ChatMessage[]
  styleExamples StyleExample[]

  @@index([userId, createdAt])
}

// ---------- AI 回复与反馈学习 ----------

model ReplyGeneration {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId        String?
  conversation          Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerId            String?
  customer              Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  inputSnapshot         Json? // 输入上下文快照
  replyText             String
  customerIntent        Json? // 客户意图分析
  salesStage            String? // 咨询阶段
  nextAction            String?
  knowledgeReferences   Json? // 知识来源引用
  uncertaintyFlags      Json? // 不确定信息提醒
  styleProfileVersionId String?
  styleProfileVersion   StyleProfileVersion? @relation(fields: [styleProfileVersionId], references: [id], onDelete: SetNull)
  modelVersion          String?
  latencyMs             Int?
  qualityCheck          Json? // 智能质检结果：{passed, issues[], warnings[], autoFixed}
  timingBreakdown       Json? // 各环节真实耗时（检索/分析/生成等）
  isCollected           Boolean              @default(false) // 是否收藏为优秀话术
  effectiveFlag         Boolean              @default(false) // 是否确认沟通效果好
  status                String               @default("GENERATED") // GENERATED / REGENERATED / FAILED
  createdAt             DateTime             @default(now())

  feedback   ReplyFeedback?
  savedReply SavedReply?

  @@index([userId, createdAt])
  @@index([conversationId])
}

model ReplyFeedback {
  id                String          @id @default(cuid())
  replyGenerationId String          @unique
  generation        ReplyGeneration @relation(fields: [replyGenerationId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  editedText        String? // 顾问修改后的版本
  finalText         String? // 确认实际发送的版本
  sentAt            DateTime?
  diffSummary       Json? // AI 生成与最终版本的差异分析
  usedAsStyleSample Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([userId, createdAt])
}

// ---------- 知识库 ----------

model KnowledgeDocument {
  id               String          @id @default(cuid())
  title            String
  category         String // IELTS / TOEFL / SALES / COURSE / ...
  examType         String?
  content          String // 解析后的正文
  sourceType       String // official / manual / upload / internal
  sourceUrl        String?
  effectiveDate    DateTime?
  verifiedAt       DateTime?
  reviewStatus     KnowledgeStatus @default(PENDING_APPROVAL)
  version          Int             @default(1)
  applicableRegion String?
  tags             Json?
  uploadedById     String?
  uploadedBy       User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  chunks KnowledgeChunk[]

  @@index([category, reviewStatus])
  @@index([examType])
  @@index([reviewStatus])
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  documentId String
  document   KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1024)")? // pgvector 向量，知识检索阶段启用
  tokenCount Int?
  createdAt  DateTime                     @default(now())

  @@index([documentId, chunkIndex])
}

// ---------- 课程产品 ----------

model CourseProduct {
  id          String   @id @default(cuid())
  name        String
  category    String?
  priceCents  Int? // 价格（分）
  hours       Int?
  description String?
  services    Json? // 服务项目
  policies    Json? // 政策（退费 / 转班等）
  status      String   @default("ACTIVE")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, status])
}

// ---------- 审计日志 ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // LOGIN / UPLOAD_SCREENSHOT / CREATE_KNOWLEDGE ...
  entityType String?
  entityId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// V2.0 增量表（不改动既有表的业务语义，仅新增）
// ============================================================

// ---------- 客户事实与来源（功能4/5：事实/推测区分、来源追踪、矛盾检测）----------
model CustomerFact {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  fieldKey       String // 字段标识：contactRole/targetCountry/targetExam/targetScore/budgetRange...
  value          String // 事实值
  factType       String // CONFIRMED 明确事实 / INFERRED 可能性推测
  sourceType     String // conversation 对话提取 / manual 手动录入 / confirmed 人工确认
  confidence     Float? // 推测置信度（0-1）
  status         String // ACTIVE 当前有效 / SUPERSEDED 已被新值取代 / DISPUTED 矛盾待确认
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerId, fieldKey])
  @@index([userId, status])
  @@index([conversationId])
}

// ---------- 客户沟通分析（功能1：需求/顾虑/阶段，结果可复用）----------
model ConversationAnalysis {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  analysis       Json // 完整结构化分析（显性需求/潜在顾虑/态度/阶段/确认信息/沟通方向）
  modelVersion   String?
  latencyMs      Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([userId, createdAt])
}

// ---------- 优秀话术库（功能3：收藏/发送/效果好四态、相似检索）----------
model SavedReply {
  id                String                       @id @default(cuid())
  userId            String
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?                    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId    String?
  conversation      Conversation?                @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  replyGenerationId String?                      @unique
  replyGeneration   ReplyGeneration?             @relation(fields: [replyGenerationId], references: [id], onDelete: SetNull)
  content           String // 话术内容
  questionType      String? // 客户问题类型
  examType          String? // 适用考试
  stage             String? // 咨询阶段
  customerConcern   String? // 主要客户顾虑
  strategy          String? // 回复策略
  styleTraits       Json? // 个人表达特点
  customerContext   String? // 对应的客户上下文
  status            String                       @default("COLLECTED") // COLLECTED 收藏 / SENT 已发送 / EFFECTIVE 效果好
  favorite          Boolean                      @default(true)
  embedding         Unsupported("vector(1024)")? // 相似场景检索向量
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([userId, status])
  @@index([customerId])
  @@index([conversationId])
}

// ---------- 客户跟进待办（功能6）----------
model FollowUpTask {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String // 跟进事项
  description    String?
  taskType       String // CUSTOMER_PROMISED 客户约定 / ADVISOR_PROMISED 顾问承诺 / AI_SUGGESTED AI建议
  source         String // AUTO 自动提取 / CONFIRMED 确认后进入 / MANUAL 手动创建
  dueDate        DateTime? // 跟进日期
  status         String        @default("PENDING") // PENDING 待办 / DONE 已完成 / CANCELLED 已取消
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([customerId])
}

// ---------- 语言备考方案（功能7）----------
model StudyPlan {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  planData       Json // 完整备考方案（目标/待补充/阶段/重点/评估节点/风险）
  wechatVersion  String? // 简洁微信沟通版本
  modelVersion   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([customerId])
}

// ---------- 常用销售资料（功能9）----------
model SalesMaterial {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  materialType        String // COURSE_INTRO 课程介绍 / PRICE_LIST 价格表 / ONE_ON_ONE 一对一 / GROUP_CLASS 班课 / ASSESSMENT 测评 / TRIAL 试听 / SERVICE_SCOPE 服务范围 / FAQ 常见问题 / ADVANTAGE 机构优势
  content             String? // 可复制文字
  fileUrl             String? // 可查看文件链接
  filePath            String? // 受保护存储路径
  favorite            Boolean  @default(false)
  knowledgeDocumentId String? // 关联知识库文档
  status              String   @default("APPROVED") // APPROVED 已审核 / PENDING 待审核
  tags                Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, materialType])
  @@index([userId, favorite])
}

// ---------- V6.1 个人数字身份（私人 AI 顾问工作室）----------
model PersonalIdentity {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname       String?  // 中文昵称，如 小雅
  englishName    String?  // 英文显示名，如 Ya
  monogram       String?  // 专属字母组合，如 YA / HY
  title          String?  // 职业标签，如 语言规划顾问
  bio            String?  // 个人简介
  welcomeMessage String?  // 专属欢迎语
  signature      String?  // 个人署名
  avatarMode     String   @default("MONOGRAM") // MONOGRAM 字母徽章 / INITIAL 首字 / SIGNATURE 签名
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------- V6.1 个人主题与工作台偏好 ----------
model UserThemePreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme            String   @default("rose-champagne") // rose-champagne 玫瑰香槟 / twilight-berry 暮光莓酒 / moonlight-rose 月光蔷薇 / peach-velvet 蜜桃丝绒
  density          String   @default("comfortable")   // compact 紧凑 / comfortable 舒展 / spacious 宽松
  radius           String   @default("soft")          // sharp 利落 / soft 柔和 / round 圆润
  motion           String   @default("gentle")        // none 关闭 / gentle 轻微
  welcomeArea      Boolean  @default(true)            // 首页欢迎区是否显示
  sidebarCollapsed Boolean  @default(false)
  background       String   @default("rose-desk")     // 欢迎区背景
  workspaceModules Json?    // 工作台模块显隐与顺序
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
